<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Student Web Project - Car Sales</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f2f2f2;
    }

    header {
      background-color: #333;
      color: white;
      padding: 20px;
      text-align: center;
    }

    nav {
      background-color: #444;
      padding: 10px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
    }

    .container {
      padding: 20px;
    }

    .car-listing {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: space-around;
    }

    .car-card {
      background-color: white;
      border: 1px solid #ccc;
      border-radius: 8px;
      width: 300px;
      padding: 10px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }

    .car-card img {
      width: 100%;
      border-radius: 5px;
    }

    .car-card h3 {
      margin: 10px 0 5px;
    }

    .car-card p {
      margin: 0;
      font-size: 14px;
    }

    footer {
      background-color: #333;
      color: white;
      text-align: center;
      padding: 10px;
      margin-top: 40px;
    }
  </style>
</head>
<body>
<header>
    <h1>My First Web Project</h1>
  </header>

  <nav>
    <a href="#">Home</a>
    <a href="#">Cars</a>
    <a href="#">Contact</a>
  </nav>

  <div class="container">
    <h2>Cars for Sale</h2>
    <div class="car-listing">
      
      <div class="car-card">
        <img src="4da91bcf-6c54-4dad-b77b-7df83d6a3da0.png" alt="Car 1">
        <h3>Mercedes C63 AMG</h3>
        <p>Year: 2019<br>Price: $62,000<br>Condition: Excellent</p>
      </div>

      <div class="car-card">
        <img src="04884445-a3fe-489d-ab00-c2599b8f9af3.png" alt="Car 2">
        <h3>Mercedes GLE 63 Coupe</h3>
        <p>Year: 2021<br>Price: $89,000<br>Condition: Like New</p>
      </div>

      <div class="car-card">
        <img src="98551f78-ceeb-4d06-8291-54071525b16c.png" alt="Car 3">
        <h3>Mercedes E63 S</h3>
        <p>Year: 2020<br>Price: $78,000<br>Condition: Great</p>
      </div>

    </div>
  </div>

  <footer>
    <p>&copy; 2025 Car Sales by Student</p>
  </footer>

</body>
</html>
